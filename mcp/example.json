{
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "DATABASE_URI", "crystaldba/postgres-mcp"],
      "access_mode": "unrestricted",
      "enabled": true,
      "environment": {"DATABASE_URI": "{env:DATABASE_URI}"}
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "disabled": false
    },
    "playwright": {
      "type": "local",
      "command": [".opencode/mcp/playwright/playwright-launcher"],
      "enabled": true,
      "environment": {
        "COMPOSE_FILE": ".opencode/mcp/playwright/compose.yaml"
      }
    },
    "novamira": {
      "type": "local",
      "command": [".opencode/mcp/novamira/launcher"],
      "disabled": false,
      "env_file": ".env.novamira",
      "environment": {
        "WP_API_URL": "{env:WP_API_URL}",
        "WP_API_USERNAME": "{env:WP_API_USERNAME}",
        "WP_API_PASSWORD": "{env:WP_API_PASSWORD}",
        "OAUTH_ENABLED": "false",
        "NODE_OPTIONS": "--use-system-ca"
      }
    }
  }
}
