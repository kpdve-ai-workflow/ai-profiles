{
  "type": "local",
  "command": ["python3", ".opencode/mcp/mariadb/launch.py"],
  "disabled": true,
  "timeout": {"startup": 3600000},
  "environment": {
    "DB_HOST": "{env:DB_HOST}",
    "DB_PORT": "{env:DB_PORT}",
    "DB_NAME": "{env:DB_NAME}",
    "DB_USER": "{env:DB_USER}",
    "DB_PASSWORD": "{env:DB_PASSWORD}",
    "MCP_READ_ONLY": "false",
    "MCP_BLOCK_SENSITIVE_SHOW": "false"
  }
}
