{
  "mcp": {
    "postgres": {
      "command": [
        "docker", "run", "-i", "--rm",
        "--network", "my-project_default",
        "-e", "DATABASE_URI",
        "crystaldba/postgres-mcp"
      ],
      "access_mode": "unrestricted",
      "env_file": ".ai-profiles/mcp/postgres/.env.stage",
      "environment": {
        "DATABASE_URI": "{env:STAGE_DATABASE_URL}"
      }
    }
  }
}
